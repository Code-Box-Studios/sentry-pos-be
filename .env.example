DATABASE_URL=postgresql://sentry:sentry@localhost:54400/sentry_pos_dev
DIRECT_URL=postgresql://sentry:sentry@localhost:54400/sentry_pos_dev
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_PAIRING_SECRET=dev-pairing-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# RESEND_API_KEY=       # unset in dev → mail logs to console
# MAIL_FROM=Sentry <no-reply@example.com>
# Set false to deploy without Resend. Invites, emailed PINs, password resets,
# and daily summaries will not send. In-app notifications remain enabled.
MAIL_ENABLED=true
PORT=4000

# Where invite and password-reset emails link to — the portal in sentry-pos-landing.
# Defaults to http://localhost:3000 in code, which is the POS TERMINAL: left unset, every
# owner invite lands on an app that has no /invite/accept route.
APP_URL=http://localhost:3100

# Private S3-compatible tenant images. Required together in production.
TENANT_STORAGE_BUCKET=
TENANT_STORAGE_ENDPOINT=
TENANT_STORAGE_REGION=ap-southeast-1
TENANT_STORAGE_ACCESS_KEY_ID=
TENANT_STORAGE_SECRET_ACCESS_KEY=
# Run the notification/digest/retention worker in a long-lived API process.
# Set false in tests and on processes that should not run jobs.
JOBS_ENABLED=true
